# Copia este archivo como `.env` (el archivo .env NO se versiona: el repositorio es publico) y completa los valores.
# docker compose lo lee solo. Guia completa: docs/AUTENTICACION.md

# --- Autenticacion con roles ---
# false = todo funciona como siempre, sin login. true = hay que iniciar sesion.
AUTH_ENABLED=false

# Clave con la que se firma el token. OBLIGATORIA si AUTH_ENABLED=true, minimo 32 caracteres.
# Debe ser la misma para los 4 servicios (docker compose ya se la pasa a todos). Generala asi:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   openssl rand -base64 48
JWT_SECRET=

# Administrador inicial: se crea solo la primera vez, si ese usuario no existe. La clave, de al menos 8 caracteres.
ADMIN_USUARIO=admin
ADMIN_CLAVE=
ADMIN_NOMBRE=Administrador
